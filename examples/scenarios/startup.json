{
  "seed": 12345,
  "primary_region": "edge",
  "load_balancer": "Random",
  "invocation": {
    "can_offload": true
  },
  "scheduler": {
    "queue": {
      "capacity": 2
    }
  },
  "containers": {
    "idle_timeout": 2.0,
    "cleanup_interval": 0.5,
    "startup_times": {
      "grussorusso/serverledge-python314": 0.125
    }
  },
  "functions": [
    {
      "name": "hello",
      "first_arrival_time": 1.0,
      "code_load_time": 0.075,
      "runtime": "python314",
      "memory_mb": 128,
      "cpu_demand": 1.0,
      "max_concurrency": 1,
      "supported_archs": [
        "amd64",
        "arm64"
      ],
      "tag_pattern": "amd64*",
      "arrival_rate": 2.0,
      "service_rate": 4.0
    },
    {
      "name": "resize",
      "first_arrival_time": 1.5,
      "code_load_time": 0.275,
      "runtime": "python314",
      "memory_mb": 256,
      "cpu_demand": 0.5,
      "max_concurrency": 2,
      "supported_archs": [
        "amd64"
      ],
      "tag_pattern": "amd64*",
      "arrival_rate": 1.0,
      "service_rate": 2.0
    },
    {
      "name": "telemetry",
      "runtime": "python314",
      "supported_archs": [
        "arm64"
      ],
      "tag_pattern": "gateway-arm",
      "memory_mb": 128,
      "cpu_demand": 1.0,
      "first_arrival_time": 2,
      "arrival_rate": 2,
      "service_rate": 2,
      "arrival_distribution": "deterministic",
      "service_distribution": "deterministic"
    },
    {
      "name": "archive",
      "runtime": "python314",
      "supported_archs": [
        "arm64"
      ],
      "tag_pattern": "archive-arm",
      "memory_mb": 128,
      "cpu_demand": 1.0,
      "first_arrival_time": 2.25,
      "arrival_rate": 0.5,
      "service_rate": 2,
      "arrival_distribution": "deterministic",
      "service_distribution": "deterministic"
    },
    {
      "name": "burst",
      "runtime": "python314",
      "supported_archs": [
        "arm64"
      ],
      "tag_pattern": "forward-arm",
      "memory_mb": 128,
      "cpu_demand": 1.0,
      "first_arrival_time": 2.5,
      "arrival_rate": 4,
      "service_rate": 2,
      "arrival_distribution": "deterministic",
      "service_distribution": "deterministic"
    },
    {
      "name": "index",
      "runtime": "python314",
      "supported_archs": [
        "arm64"
      ],
      "tag_pattern": "regional-arm",
      "memory_mb": 128,
      "cpu_demand": 1.0,
      "first_arrival_time": 3,
      "arrival_rate": 0.5,
      "service_rate": 4,
      "arrival_distribution": "deterministic",
      "service_distribution": "deterministic"
    }
  ],
  "regions": {
    "edge": {
      "infrastructure": {
        "rings": [
          {
            "id": "edge-x86",
            "arch": "amd64",
            "memory_mb": 512,
            "cpus": 2.0,
            "nodes": [
              {
                "name": "edge-1"
              },
              {
                "name": "edge-2",
                "machine_tag": "amd64/standard"
              }
            ]
          },
          {
            "id": "edge-arm-gateways",
            "arch": "arm64",
            "memory_mb": 512,
            "cpus": 1.0,
            "nodes": [
              {
                "name": "gateway",
                "machine_tag": "gateway-arm",
                "policy": "edgecloud",
                "remote_region": "regional"
              },
              {
                "name": "archive",
                "machine_tag": "archive-arm",
                "policy": "cloudonly",
                "remote_region": "cloud"
              },
              {
                "name": "forwarder",
                "machine_tag": "forward-arm",
                "policy": "edgeonly",
                "nearest_neighbors": [
                  "edge-worker"
                ]
              },
              {
                "name": "relay",
                "machine_tag": "regional-arm",
                "policy": "cloudonly",
                "remote_region": "regional"
              }
            ]
          },
          {
            "id": "edge-arm-workers",
            "arch": "arm64",
            "memory_mb": 512,
            "cpus": 1.0,
            "nodes": [
              {
                "name": "edge-worker"
              }
            ]
          }
        ]
      }
    },
    "regional": {
      "has_load_balancer": false,
      "offload_latency_s": 0.5,
      "infrastructure": {
        "rings": [
          {
            "id": "regional-arm",
            "arch": "arm64",
            "memory_mb": 512,
            "cpus": 1.0,
            "nodes": [
              {
                "name": "regional-worker"
              }
            ]
          }
        ]
      }
    },
    "cloud": {
      "mode": "always_succeeds",
      "service_time_s": 0.375,
      "offload_latency_s": 0.5,
      "offload_latency_by_source_s": {
        "edge": 0.25
      }
    }
  }
}
